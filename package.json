{
  "name": "beerfactory-staff-portal",
  "private": true,
  "version": "40.4.0-alpha.1",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "sync:public": "node scripts/sync-public.mjs",
    "predev": "npm run sync:public",
    "dev": "vite",
    "prebuild": "npm run sync:public",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:ci",
    "test:ci": "node --test --test-isolation=none tests/edge-contract.test.cjs tests/backend-hardening.test.cjs tests/performance-network.test.cjs tests/visual-architecture-hardening.test.cjs tests/reliability-hardening.test.cjs tests/attestation-editor-r40.6.test.cjs",
    "test:browser": "node tests/run-browser.mjs",
    "knowledge:seed:dry-run": "node scripts/build-knowledge-legacy-seed.mjs",
    "dev:preview": "npm run sync:public && vite --mode r40.5-preview",
    "build:preview": "npm run sync:public && tsc -b && vite build --mode r40.5-preview",
    "knowledge:seed:live-history": "node tools/build-knowledge-legacy-seed.mjs ."
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.58.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0"
  }
}
