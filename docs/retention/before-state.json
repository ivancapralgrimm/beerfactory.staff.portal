  "existingCleanupFunctions": [
    {
      "nspname": "public",
      "proname": "cleanup_recovery_attempts",
      "definition": "CREATE OR REPLACE FUNCTION public.cleanup_recovery_attempts()\n RETURNS void\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  delete from public.recovery_attempts where attempted_at < now() - interval '24 hours';\n$function$\n"
    },
    {
      "nspname": "private",
      "proname": "cleanup_handover_history",
      "definition": "CREATE OR REPLACE FUNCTION private.cleanup_handover_history()\n RETURNS integer\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'private'\nAS $function$\ndeclare\n  v_deleted integer;\nbegin\n  delete from public.notes\n  where created_at < now() - interval '60 days';\n\n  get diagnostics v_deleted = row_count;\n  return v_deleted;\nend;\n$function$\n"
